DATABASE_FILE=data/ure.sqlite
# Set for HTTPS deployments
# PUBLIC_ORIGIN=https://game.example.org
# TRUSTED_PROXY=127.0.0.1
# Production startup requires NODE_ENV=production, an HTTPS PUBLIC_ORIGIN
# and an absolute DATABASE_FILE on the persistent volume.
# NARRATOR_API_KEY=
# NARRATOR_MODEL=

# NARRATOR_URL=https://your-provider.example/v1/chat/completions
# Optional transactional mail gateway accepting JSON with to, subject and text.
# Verification and recovery also require an HTTPS PUBLIC_ORIGIN.
# ACCOUNT_MAIL_URL=https://your-mail-gateway.example/send
# ACCOUNT_MAIL_KEY=
